        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für alle verfügbaren Filme ist eine Auswahl gespeichert. Mache eine Auswahl rückgängig oder suche nach neuen Filmen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os filmes disponíveis têm uma escolha salva. Desfaça uma escolha ou procure novos filmes."
